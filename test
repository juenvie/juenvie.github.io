<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #F5F0E8;
    --sand: #E8DDD0;
    --terracotta: #C4714A;
    --deep: #1C1410;
    --mid: #5C4A3A;
    --light: #9A8878;
    --accent: #C4714A;
    --white: #FDFAF6;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--cream);
    color: var(--deep);
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 48px;
    background: rgba(245,240,232,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(92,74,58,0.12);
  }
  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px; font-weight: 300; font-style: italic;
    letter-spacing: 0.02em; color: var(--deep);
    text-decoration: none;
  }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a {
    font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mid); text-decoration: none; transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--terracotta); }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 0 48px;
    padding-top: 80px;
    gap: 80px;
  }
  .hero-text { max-width: 560px; }
  .hero-eyebrow {
    font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--terracotta); margin-bottom: 24px;
    display: flex; align-items: center; gap: 12px;
  }
  .hero-eyebrow::before {
    content: ''; width: 32px; height: 1px; background: var(--terracotta);
  }
  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(52px, 6vw, 88px);
    font-weight: 300; line-height: 1.0;
    letter-spacing: -0.01em;
    margin-bottom: 32px;
  }
  .hero-title em { font-style: italic; color: var(--terracotta); }
  .hero-sub {
    font-size: 16px; line-height: 1.7; color: var(--mid);
    margin-bottom: 48px; max-width: 440px;
  }
  .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }
  .btn-primary {
    display: inline-block; padding: 14px 32px;
    background: var(--deep); color: var(--white);
    font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; transition: all 0.25s;
  }
  .btn-primary:hover { background: var(--terracotta); }
  .btn-secondary {
    display: inline-block; padding: 13px 32px;
    border: 1px solid var(--deep); color: var(--deep);
    font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; transition: all 0.25s;
  }
  .btn-secondary:hover { border-color: var(--terracotta); color: var(--terracotta); }

  .hero-visual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 8px;
    height: 580px;
  }
  .hero-img {
    background: var(--sand);
    overflow: hidden;
    position: relative;
  }
  .hero-img:first-child { grid-row: span 2; }
  .hero-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .hero-img:hover img { transform: scale(1.04); }
  .hero-img-label {
    position: absolute; bottom: 12px; left: 12px;
    font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    color: white; background: rgba(28,20,16,0.6);
    padding: 4px 8px; backdrop-filter: blur(4px);
  }

  /* STATS BAR */
  .stats-bar {
    background: var(--deep);
    padding: 32px 48px;
    display: flex; justify-content: space-around; align-items: center;
    flex-wrap: wrap; gap: 24px;
  }
  .stat { text-align: center; }
  .stat-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: 42px; font-weight: 300; color: var(--white);
    line-height: 1;
  }
  .stat-label {
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--light); margin-top: 6px;
  }
  .stat-divider { width: 1px; height: 48px; background: rgba(255,255,255,0.15); }

  /* SECTION BASE */
  section { padding: 100px 48px; }
  .section-label {
    font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--terracotta); margin-bottom: 16px;
  }
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 300; line-height: 1.1;
    margin-bottom: 48px;
  }

  /* BALI AVAILABILITY BANNER */
  .bali-banner {
    background: var(--terracotta);
    padding: 20px 48px;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 12px;
  }
  .bali-banner-text {
    color: white;
    font-size: 15px; font-weight: 400;
  }
  .bali-banner-text strong {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px; font-style: italic;
  }
  .bali-tag {
    background: rgba(255,255,255,0.2);
    color: white; padding: 6px 16px;
    font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
    border: 1px solid rgba(255,255,255,0.4);
  }

  /* WHAT I CREATE */
  .services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2px; background: var(--sand);
    margin-top: 48px;
  }
  .service-card {
    background: var(--cream); padding: 40px 32px;
    transition: background 0.25s;
  }
  .service-card:hover { background: var(--white); }
  .service-icon { font-size: 28px; margin-bottom: 20px; }
  .service-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px; font-weight: 400; margin-bottom: 12px;
  }
  .service-desc { font-size: 14px; color: var(--mid); line-height: 1.6; }

  /* PORTFOLIO GRID */
  .portfolio-section { background: var(--white); }
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 220px;
    gap: 4px;
  }
  .portfolio-item {
    background: var(--sand); overflow: hidden;
    position: relative; cursor: pointer;
  }
  .portfolio-item.wide { grid-column: span 2; }
  .portfolio-item.tall { grid-row: span 2; }
  .portfolio-item img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s ease;
  }
  .portfolio-item:hover img { transform: scale(1.06); }
  .portfolio-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(28,20,16,0.7) 0%, transparent 50%);
    opacity: 0; transition: opacity 0.3s;
    display: flex; align-items: flex-end; padding: 20px;
  }
  .portfolio-item:hover .portfolio-overlay { opacity: 1; }
  .portfolio-tag {
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: white;
  }

  /* PROOF / RESULTS */
  .proof-section { background: var(--cream); }
  .proof-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 48px; margin-top: 48px;
  }
  .proof-card {
    border-left: 2px solid var(--terracotta);
    padding-left: 28px;
  }
  .proof-card-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: 56px; font-weight: 300; color: var(--terracotta);
    line-height: 1;
  }
  .proof-card-label {
    font-size: 13px; color: var(--mid); margin-top: 8px; line-height: 1.5;
  }
  .proof-collab {
    background: var(--deep); color: var(--white);
    padding: 36px; margin-top: 48px;
  }
  .proof-collab-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px; font-style: italic; font-weight: 300;
    line-height: 1.4; margin-bottom: 20px;
  }
  .proof-collab-meta { font-size: 13px; color: var(--light); }

  /* PACKAGES */
  .packages-section { background: var(--sand); }
  .packages-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 24px; margin-top: 48px;
  }
  .package-card {
    background: var(--white); padding: 48px 40px;
    position: relative;
  }
  .package-card.featured {
    background: var(--deep); color: var(--white);
  }
  .package-badge {
    position: absolute; top: 24px; right: 24px;
    background: var(--terracotta); color: white;
    font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 4px 10px;
  }
  .package-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 30px; font-weight: 300; margin-bottom: 8px;
  }
  .package-desc { font-size: 14px; color: var(--light); margin-bottom: 32px; line-height: 1.5; }
  .package-card.featured .package-desc { color: rgba(255,255,255,0.6); }
  .package-items { list-style: none; }
  .package-items li {
    font-size: 14px; padding: 10px 0;
    border-bottom: 1px solid rgba(92,74,58,0.12);
    display: flex; align-items: flex-start; gap: 10px;
    line-height: 1.4;
  }
  .package-card.featured .package-items li { border-bottom-color: rgba(255,255,255,0.1); }
  .package-items li::before {
    content: '→'; color: var(--terracotta);
    font-size: 12px; margin-top: 2px; flex-shrink: 0;
  }
  .package-value {
    margin-top: 28px;
    font-size: 13px; color: var(--light);
    font-style: italic;
  }
  .package-card.featured .package-value { color: rgba(255,255,255,0.5); }

  /* CONTACT */
  .contact-section {
    background: var(--deep); color: var(--white);
    text-align: center; padding: 100px 48px;
  }
  .contact-section .section-title { margin-bottom: 20px; }
  .contact-section .section-title,
  .contact-section .section-label { color: var(--white); }
  .contact-section .section-label { color: var(--terracotta); }
  .contact-sub {
    font-size: 16px; color: rgba(255,255,255,0.6);
    max-width: 480px; margin: 0 auto 48px; line-height: 1.7;
  }
  .contact-links {
    display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .contact-link {
    display: inline-block; padding: 14px 36px;
    background: var(--terracotta); color: white;
    font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; transition: background 0.2s;
  }
  .contact-link:hover { background: #b05e38; }
  .contact-link.outline {
    background: transparent; border: 1px solid rgba(255,255,255,0.3); color: white;
  }
  .contact-link.outline:hover { border-color: white; }
  .social-handle {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px; font-style: italic; color: rgba(255,255,255,0.4);
  }

  /* FOOTER */
  footer {
    background: var(--deep); border-top: 1px solid rgba(255,255,255,0.08);
    padding: 20px 48px;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 12px;
  }
  footer span { font-size: 12px; color: rgba(255,255,255,0.3); }

  /* ANIMATIONS */
  .fade-up {
    opacity: 0; transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .fade-up.visible { opacity: 1; transform: translateY(0); }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    nav { padding: 16px 24px; }
    .nav-links { display: none; }
    .hero { grid-template-columns: 1fr; padding: 100px 24px 48px; gap: 40px; min-height: auto; }
    .hero-visual { height: 360px; }
    section { padding: 64px 24px; }
    .stats-bar { padding: 24px; }
    .bali-banner { padding: 16px 24px; }
    .services-grid { grid-template-columns: 1fr; }
    .portfolio-grid { grid-template-columns: 1fr 1fr; }
    .portfolio-item.wide { grid-column: span 1; }
    .proof-grid { grid-template-columns: 1fr; }
    .packages-grid { grid-template-columns: 1fr; }
    footer { padding: 16px 24px; }
  }
</style>
</head>
